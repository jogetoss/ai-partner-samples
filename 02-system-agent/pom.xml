<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.joget.samples</groupId>
    <artifactId>form-naming-auditor</artifactId>
    <packaging>bundle</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>form-naming-auditor</name>
    <description>System agent for Agent Builder: audits form and list naming of a Joget app and writes the report.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>11</maven.compiler.release>
        <!--
            The Joget platform version to compile against. Override it on the command line with the version that is
            in your local Maven repository, for example:  mvn clean package "-Djoget.version=9.1.2"
            (00-setup/install-joget-jars installs the jars of your own Joget installation and prints the version).
        -->
        <joget.version>9.1.2</joget.version>
        <!-- The Agent Builder API jar, installed by 00-setup/install-api-jar. -->
        <agent-builder.version>8.2.5-ALPHA</agent-builder.version>
        <!-- Public libraries the platform classes refer to. Compile only; Joget supplies its own copies at run time. -->
        <spring.version>5.3.39</spring.version>
        <json.version>20231013</json.version>
        <osgi.version>6.0.0</osgi.version>
        <javax.servlet.version>3.1.0</javax.servlet.version>
        <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
    </properties>

    <!--
        No <repositories> on purpose: everything except the Joget artifacts comes from Maven Central, and the Joget
        artifacts come from your local Maven repository (see 00-setup). If you have a login for the Joget Maven
        repository, add that repository and its credentials in your own Maven settings.xml.
    -->

    <build>
        <plugins>
            <!--
                Servlet namespace. Joget DX 9 uses jakarta.servlet. One class of this
                sample, NamingAuditorPage, overrides a platform method that takes servlet types, so it must be compiled
                with the namespace of the platform jars. The source in src/main/java uses javax.servlet.

                The three steps below derive the namespace from joget.version (major version 9 or higher = jakarta).
                For jakarta they compile a copy of NamingAuditorPage.java in which "javax.servlet" is replaced by
                "jakarta.servlet", instead of the original. For javax nothing is copied and nothing is excluded.
                The properties servlet.namespace and servlet.switch are set while the build runs; do not define them
                in <properties>.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <!-- "jakarta" for 9.x and later; otherwise the version text itself -->
                        <id>servlet-namespace-1</id>
                        <phase>initialize</phase>
                        <goals><goal>regex-property</goal></goals>
                        <configuration>
                            <name>servlet.namespace.raw</name>
                            <value>${joget.version}</value>
                            <regex>^(9|[1-9][0-9]+)[.-].*$</regex>
                            <replacement>jakarta</replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- servlet.namespace = jakarta or javax -->
                        <id>servlet-namespace-2</id>
                        <phase>initialize</phase>
                        <goals><goal>regex-property</goal></goals>
                        <configuration>
                            <name>servlet.namespace</name>
                            <value>${servlet.namespace.raw}</value>
                            <regex>^(?!jakarta$).*$</regex>
                            <replacement>javax</replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- servlet.switch = the file to convert (jakarta) or a name that matches no file (javax) -->
                        <id>servlet-namespace-3</id>
                        <phase>initialize</phase>
                        <goals><goal>regex-property</goal></goals>
                        <configuration>
                            <name>servlet.switch</name>
                            <value>${servlet.namespace}</value>
                            <regex>^jakarta$</regex>
                            <replacement>NamingAuditorPage.java</replacement>
                            <failIfNoMatch>false</failIfNoMatch>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-converted-source</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>${project.build.directory}/generated-sources/servlet</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>convert-servlet-namespace</id>
                        <phase>generate-sources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/generated-sources/servlet/jakarta"/>
                                <copy todir="${project.build.directory}/generated-sources/servlet/jakarta" flatten="true" encoding="UTF-8">
                                    <fileset dir="${project.basedir}/src/main/java" includes="**/${servlet.switch}"/>
                                    <filterchain>
                                        <replacestring from="javax.servlet" to="jakarta.servlet"/>
                                    </filterchain>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- jakarta: skip the original page class, the converted copy is compiled instead. javax: matches nothing. -->
                    <excludes>
                        <exclude>org/joget/samples/systemagent/${servlet.switch}</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>5.1.9</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>org.joget.samples.form-naming-auditor</Bundle-SymbolicName>
                        <!-- Nothing is exported: other bundles never call into this one. -->
                        <Private-Package>org.joget.samples.systemagent.*</Private-Package>
                        <Export-Package>!*</Export-Package>
                        <Bundle-Activator>org.joget.samples.systemagent.Activator</Bundle-Activator>
                        <!--
                            Every package is resolved lazily from whichever bundle exports it (Agent Builder exports
                            org.joget.ai.agent.model; Joget exports the rest). Only the packages named here are checked
                            when the bundle resolves. The servlet package is named on purpose: Joget DX 9 converts a
                            javax jar to jakarta at install only when its manifest mentions javax.servlet, and
                            version="0" stops the bundle plugin writing a [4.0,5) range.
                        -->
                        <Import-Package>!*,${servlet.namespace}.servlet;version="0",${servlet.namespace}.servlet.http;version="0",org.osgi.framework;version="1.3.0"</Import-Package>
                        <DynamicImport-Package>*</DynamicImport-Package>
                        <Joget-Name>Form Naming Auditor (system agent)</Joget-Name>
                        <Joget-Description>Settings page plus Agent Builder system agent that audits form and list naming</Joget-Description>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!--
            Joget platform, compile only. Each artifact is named explicitly and its own dependency tree is excluded,
            so the build needs exactly these jars from your local Maven repository and nothing else from Joget.
        -->
        <dependency>
            <groupId>org.joget</groupId>
            <artifactId>wflow-core</artifactId>
            <version>${joget.version}</version>
            <scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>org.joget</groupId>
            <artifactId>wflow-commons</artifactId>
            <version>${joget.version}</version>
            <scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>org.joget</groupId>
            <artifactId>wflow-plugin-base</artifactId>
            <version>${joget.version}</version>
            <scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>org.joget</groupId>
            <artifactId>wflow-wfengine</artifactId>
            <version>${joget.version}</version>
            <scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>org.joget</groupId>
            <artifactId>wflow-directory</artifactId>
            <version>${joget.version}</version>
            <scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <!-- Compile only: at run time the classes come from the installed Agent Builder plugin. Never embed this jar. -->
            <groupId>org.joget.ai.agent</groupId>
            <artifactId>agent-builder-api</artifactId>
            <version>${agent-builder.version}</version>
            <scope>provided</scope>
            <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
        </dependency>

        <!-- Public libraries (Maven Central), compile only. -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.core</artifactId>
            <version>${osgi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Both servlet APIs are on the compile class path; the packages differ, so they do not clash. -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>${javax.servlet.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>${jakarta.servlet.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
