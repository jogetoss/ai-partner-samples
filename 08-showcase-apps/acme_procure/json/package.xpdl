<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Package xmlns="http://www.wfmc.org/2002/XPDL1.0" xmlns:xpdl="http://www.wfmc.org/2002/XPDL1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Id="acme_procure" Name="Acme Procurement Portal" xsi:schemaLocation="http://www.wfmc.org/2002/XPDL1.0 http://wfmc.org/standards/docs/TC-1025_schema_10_xpdl.xsd">
    <PackageHeader>
        <XPDLVersion>1.0</XPDLVersion>
        <Vendor/>
        <Created/>
    </PackageHeader>
    <Script Type="text/javascript"/>
    <Participants>
        <Participant Id="requester" Name="Pemohon">
            <ParticipantType Type="ROLE"/>
        </Participant>
        <Participant Id="line_manager" Name="Atasan Langsung">
            <ParticipantType Type="ROLE"/>
        </Participant>
        <Participant Id="department_head" Name="Kepala Departemen">
            <ParticipantType Type="ROLE"/>
        </Participant>
        <Participant Id="finance_director" Name="Direktur Keuangan">
            <ParticipantType Type="ROLE"/>
        </Participant>
    </Participants>
    <Applications>
        <Application Id="default_application"/>
    </Applications>
    <WorkflowProcesses>
        <WorkflowProcess Id="purchase_request" Name="Proses Permintaan Pembelian">
            <ProcessHeader DurationUnit="h"/>
            <DataFields>
                <DataField Id="acme_total_amount" IsArray="FALSE">
                    <DataType>
                        <BasicType Type="STRING"/>
                    </DataType>
                </DataField>
                <DataField Id="acme_decision" IsArray="FALSE">
                    <DataType>
                        <BasicType Type="STRING"/>
                    </DataType>
                </DataField>
            </DataFields>
            <Activities>
                <Activity Id="submit" Name="Pengajuan">
                    <Implementation>
                        <Tool Id="default_application"/>
                    </Implementation>
                    <Performer>requester</Performer>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="requester"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="120,40"/>
                    </ExtendedAttributes>
                </Activity>
                <Activity Id="review_manager" Name="Persetujuan Atasan">
                    <Implementation>
                        <No/>
                    </Implementation>
                    <Performer>line_manager</Performer>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="line_manager"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="120,30"/>
                    </ExtendedAttributes>
                </Activity>
                <Activity Id="route_manager">
                    <Route/>
                    <Performer>line_manager</Performer>
                    <TransitionRestrictions>
                        <TransitionRestriction>
                            <Split Type="XOR">
                                <TransitionRefs>
                                    <TransitionRef Id="t_mgr_reject"/>
                                    <TransitionRef Id="t_mgr_head"/>
                                    <TransitionRef Id="t_mgr_done"/>
                                </TransitionRefs>
                            </Split>
                        </TransitionRestriction>
                    </TransitionRestrictions>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="line_manager"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="330,40"/>
                    </ExtendedAttributes>
                </Activity>
                <Activity Id="review_head" Name="Persetujuan Kepala Departemen">
                    <Implementation>
                        <No/>
                    </Implementation>
                    <Performer>department_head</Performer>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="department_head"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="330,30"/>
                    </ExtendedAttributes>
                </Activity>
                <Activity Id="route_head">
                    <Route/>
                    <Performer>department_head</Performer>
                    <TransitionRestrictions>
                        <TransitionRestriction>
                            <Split Type="XOR">
                                <TransitionRefs>
                                    <TransitionRef Id="t_head_reject"/>
                                    <TransitionRef Id="t_head_finance"/>
                                    <TransitionRef Id="t_head_done"/>
                                </TransitionRefs>
                            </Split>
                        </TransitionRestriction>
                    </TransitionRestrictions>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="department_head"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="540,40"/>
                    </ExtendedAttributes>
                </Activity>
                <Activity Id="review_finance" Name="Persetujuan Keuangan">
                    <Implementation>
                        <No/>
                    </Implementation>
                    <Performer>finance_director</Performer>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="finance_director"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="540,30"/>
                    </ExtendedAttributes>
                </Activity>
                <Activity Id="route_finance">
                    <Route/>
                    <Performer>finance_director</Performer>
                    <TransitionRestrictions>
                        <TransitionRestriction>
                            <Split Type="XOR">
                                <TransitionRefs>
                                    <TransitionRef Id="t_fin_reject"/>
                                    <TransitionRef Id="t_fin_done"/>
                                </TransitionRefs>
                            </Split>
                        </TransitionRestriction>
                    </TransitionRestrictions>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="finance_director"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="750,40"/>
                    </ExtendedAttributes>
                </Activity>
                <Activity Id="done" Name="Selesai (Disetujui)">
                    <Implementation>
                        <Tool Id="default_application"/>
                    </Implementation>
                    <Performer>requester</Performer>
                    <TransitionRestrictions>
                        <TransitionRestriction>
                            <Join Type="XOR"/>
                        </TransitionRestriction>
                    </TransitionRestrictions>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="requester"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="960,30"/>
                    </ExtendedAttributes>
                </Activity>
                <Activity Id="rejected" Name="Ditolak">
                    <Implementation>
                        <Tool Id="default_application"/>
                    </Implementation>
                    <Performer>requester</Performer>
                    <TransitionRestrictions>
                        <TransitionRestriction>
                            <Join Type="XOR"/>
                        </TransitionRestriction>
                    </TransitionRestrictions>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_PARTICIPANT_ID" Value="requester"/>
                        <ExtendedAttribute Name="JaWE_GRAPH_OFFSET" Value="960,110"/>
                    </ExtendedAttributes>
                </Activity>
            </Activities>
            <Transitions>
                <Transition From="submit" Id="t_submit_mgr" To="review_manager">
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="review_manager" Id="t_mgr_route" To="route_manager">
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="route_manager" Id="t_mgr_reject" Name="rejected" To="rejected">
                    <Condition Type="CONDITION">acme_decision==='rejected'</Condition>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="route_manager" Id="t_mgr_head" Name="above 5000000" To="review_head">
                    <Condition Type="CONDITION">parseFloat(String(acme_total_amount).split(',')[0].replace(/[^0-9]/g,'')) &gt; 5000000</Condition>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="route_manager" Id="t_mgr_done" Name="approved" To="done">
                    <Condition Type="OTHERWISE"/>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="review_head" Id="t_head_route" To="route_head">
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="route_head" Id="t_head_reject" Name="rejected" To="rejected">
                    <Condition Type="CONDITION">acme_decision==='rejected'</Condition>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="route_head" Id="t_head_finance" Name="above 50000000" To="review_finance">
                    <Condition Type="CONDITION">parseFloat(String(acme_total_amount).split(',')[0].replace(/[^0-9]/g,'')) &gt; 50000000</Condition>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="route_head" Id="t_head_done" Name="approved" To="done">
                    <Condition Type="OTHERWISE"/>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="review_finance" Id="t_fin_route" To="route_finance">
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="route_finance" Id="t_fin_reject" Name="rejected" To="rejected">
                    <Condition Type="CONDITION">acme_decision==='rejected'</Condition>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
                <Transition From="route_finance" Id="t_fin_done" Name="approved" To="done">
                    <Condition Type="OTHERWISE"/>
                    <ExtendedAttributes>
                        <ExtendedAttribute Name="JaWE_GRAPH_TRANSITION_STYLE" Value="NO_ROUTING_ORTHOGONAL"/>
                    </ExtendedAttributes>
                </Transition>
            </Transitions>
            <ExtendedAttributes>
                <ExtendedAttribute Name="JaWE_GRAPH_WORKFLOW_PARTICIPANT_ORDER" Value="requester;line_manager;department_head;finance_director"/>
                <ExtendedAttribute Name="JaWE_GRAPH_START_OF_WORKFLOW" Value="JaWE_GRAPH_PARTICIPANT_ID=requester,CONNECTING_ACTIVITY_ID=submit,X_OFFSET=40,Y_OFFSET=50,JaWE_GRAPH_TRANSITION_STYLE=NO_ROUTING_ORTHOGONAL,TYPE=START_DEFAULT"/>
                <ExtendedAttribute Name="JaWE_GRAPH_END_OF_WORKFLOW" Value="JaWE_GRAPH_PARTICIPANT_ID=requester,CONNECTING_ACTIVITY_ID=done,X_OFFSET=1130,Y_OFFSET=40,JaWE_GRAPH_TRANSITION_STYLE=NO_ROUTING_ORTHOGONAL,TYPE=END_DEFAULT"/>
                <ExtendedAttribute Name="JaWE_GRAPH_END_OF_WORKFLOW" Value="JaWE_GRAPH_PARTICIPANT_ID=requester,CONNECTING_ACTIVITY_ID=rejected,X_OFFSET=1130,Y_OFFSET=120,JaWE_GRAPH_TRANSITION_STYLE=NO_ROUTING_ORTHOGONAL,TYPE=END_DEFAULT"/>
            </ExtendedAttributes>
        </WorkflowProcess>
    </WorkflowProcesses>
    <ExtendedAttributes>
        <ExtendedAttribute Name="EDITING_TOOL" Value="Web Workflow Designer"/>
        <ExtendedAttribute Name="EDITING_TOOL_VERSION" Value="5.0-pre-alpha"/>
    </ExtendedAttributes>
</Package>
